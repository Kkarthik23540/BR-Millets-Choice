NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:karthik%40123@localhost:5432/br_millet_choice
SESSION_SECRET=
TRUST_PROXY=0

# Business details: leave unset until verified by the owner.
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_WHATSAPP=
BUSINESS_ADDRESS=
ADMIN_ALERT_EMAIL=

# Email is disabled unless SMTP is configured. No emails are reported as sent in this mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Google OAuth. Configure both values to enable the sign-in link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Optional analytics; consent and privacy policy must be configured before production use.
GA4_MEASUREMENT_ID=

# Optional custom origin and future payment integration.
PUBLIC_SITE_URL=http://localhost:3000
PAYMENT_PROVIDER=disabled
ENABLE_CASH_ON_HANDOVER=false
ENABLE_MANUAL_TRANSFER=false

# Dedicated migrated test database for integration tests (must contain "test" in the name).
BRMC_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/br_millet_choice_test
